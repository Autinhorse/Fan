---
import type { GetStaticPaths } from 'astro';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { projects, projectHref, type Project } from '../../data/projects';

export const getStaticPaths = (() =>
  projects.map((project, i) => ({
    params: { slug: project.slug },
    props: {
      project,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }))) satisfies GetStaticPaths;

interface Props { project: Project; prev: Project; next: Project }
const { project: p, prev, next } = Astro.props;
const back = p.kind === 'research' ? { href: '/#research', label: 'Research' } : { href: '/#activities', label: 'Activities' };
const posters = await Promise.all((p.videos ?? []).map((v) => getImage({ src: v.poster, width: 960, format: 'jpg' })));
const landscape = (p.videos ?? []).map((v, i) => ({ ...v, posterSrc: posters[i].src })).filter((v) => !v.portrait);
const portrait = (p.videos ?? []).map((v, i) => ({ ...v, posterSrc: posters[i].src })).filter((v) => v.portrait);
---
<Base title={`${p.title} — Zimo Fan`} description={p.summary}>
  <Nav />

  <main class={`accent-${p.accent}`}>
    <header class="detail-head">
      <div class="glow" aria-hidden="true" style="top: -160px; right: -160px; width: 560px; height: 560px; background: #3b3a9e; opacity: 0.5"></div>
      <div class="glow" aria-hidden="true" style="top: 200px; left: -240px; width: 480px; height: 480px; background: #0f6b73; opacity: 0.4"></div>
      <div class="container" style="position: relative">
        <a class="back-link" href={back.href}>← {back.label}</a>
        <div class="feature__head" style="margin-top: 28px">
          {p.dates && <span class="feature__dates">{p.dates}</span>}
          <span class="tag">{p.tag}</span>
        </div>
        <h1 class="detail-title">{p.title}</h1>
        <p class="feature__role" style="font-size: 17px">{p.role}</p>
        <p class="detail-lead">{p.lead}</p>
        <dl class="facts">
          {p.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
        </dl>
        {p.paper && (
          <div class="hero__actions" style="justify-content: flex-start; margin-top: 32px">
            <a class="btn btn--primary" href={p.paper.href} target="_blank" rel="noopener">Read the paper (PDF)</a>
            <a class="btn btn--ghost" href={p.paper.href} download>Download</a>
          </div>
        )}
      </div>
    </header>

    <div class="container">
      {p.hero ? (
        <figure class="detail-hero reveal">
          <div class={p.hero.diagram ? 'feature__hero' : 'feature__hero feature__hero--wide'}>
            <Image src={p.hero.src} alt={p.hero.alt} widths={[700, 1200, Math.min(p.hero.src.width, 1800)]} sizes="(max-width: 1280px) 100vw, 1200px" loading="eager" />
          </div>
          {p.hero.caption && <figcaption class="caption">{p.hero.caption}</figcaption>}
        </figure>
      ) : (
        <div class="detail-banner reveal" aria-hidden="true"><Icon name={p.icon} size={72} /></div>
      )}

      <div class="detail-body">
        {p.sections.map((s) => (
          <section class="detail-section reveal">
            <h2>{s.heading}</h2>
            {s.paragraphs?.map((t) => <p>{t}</p>)}
            {s.bullets && <ul class="feature__points">{s.bullets.map((b) => <li>{b}</li>)}</ul>}
            {s.steps && (
              <ol class={s.steps.length % 3 === 0 ? "steps" : "steps steps--two"}>
                {s.steps.map((st, i) => (
                  <li class="card">
                    <span class="steps__num">{String(i + 1).padStart(2, '0')}</span>
                    <h3>{st.title}</h3>
                    <p>{st.body}</p>
                  </li>
                ))}
              </ol>
            )}
          </section>
        ))}

        {p.quotes && (
          <section class="detail-section reveal">
            <h2>In others’ words</h2>
            <div class="quotes">
              {p.quotes.map((q) => (
                <blockquote class="card">
                  <p>“{q.text}”</p>
                  <footer>— {q.source}</footer>
                </blockquote>
              ))}
            </div>
          </section>
        )}
      </div>

      {p.figures && (
        <section class="detail-section detail-wide reveal">
          <h2>Gallery</h2>
          <div class="gallery" style="margin-top: 24px">
            {p.figures.map((g) => (
              <figure class={g.src.format === 'png' ? 'is-light' : undefined}>
                <Image src={g.src} alt={g.alt} widths={[420, 800]} sizes="(max-width: 700px) 100vw, 420px" />
                {g.caption && <figcaption>{g.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </section>
      )}

      {p.videos && (
        <section class="detail-section detail-wide reveal">
          <h2>Video</h2>
          {landscape.map((v) => (
            <div style="margin-top: 24px">
              <div class="video">
                <video controls preload="none" playsinline poster={v.posterSrc}><source src={v.src} type="video/mp4" /></video>
              </div>
              <p class="caption">{v.title}</p>
            </div>
          ))}
          {portrait.length > 0 && (
            <div class="video-grid">
              {portrait.map((v) => (
                <div>
                  <div class="video video--portrait">
                    <video controls preload="none" playsinline poster={v.posterSrc}><source src={v.src} type="video/mp4" /></video>
                  </div>
                  <p class="caption">{v.title}</p>
                </div>
              ))}
            </div>
          )}
        </section>
      )}

      {p.paper && (
        <section class="detail-section detail-body reveal">
          <div class="paper card">
            <span class="icon-tile"><Icon name="book" size={26} /></span>
            <div>
              <p class="eyebrow" style="margin-bottom: 10px">Paper</p>
              <h2 style="margin: 0; font-size: 24px; font-family: var(--sans); line-height: 1.35">{p.paper.title}</h2>
              <p style="margin-top: 8px">{p.paper.citation}{p.paper.note && ` ${p.paper.note}`}</p>
              <a class="text-link" href={p.paper.href} target="_blank" rel="noopener">Open PDF →</a>
            </div>
          </div>
        </section>
      )}

      {p.lesson && (
        <section class="detail-body reveal">
          <p class="lesson" style="font-size: clamp(22px, 2.6vw, 30px)">“{p.lesson}”</p>
        </section>
      )}

      <nav class="pager" aria-label="More projects">
        <a href={projectHref(prev)}><span>← Previous</span>{prev.title}</a>
        <a href={projectHref(next)} style="text-align: right"><span>Next →</span>{next.title}</a>
      </nav>
    </div>
  </main>

  <Footer />
</Base>
