---
import { profile } from '../data/site';
const year = new Date().getFullYear();
---
<footer id="contact" class="footer">
  <div class="container">
    <h2>Let’s Connect</h2>
    <p>Happy to share more about my research, projects or music.</p>
    <a class="btn btn--primary" style="margin-top: 32px" href={`mailto:${profile.email}`}>{profile.email}</a>
    <small>© {year} {profile.name} · {profile.location}</small>
  </div>
</footer>
